# ============================================================
# SECRETS — never commit, never track
# ============================================================
.env
.env.*
!.env.template
*.key
*.pem
credentials*
API.txt
api.txt
*secret*

# ============================================================
# Python environments & caches
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# ============================================================
# Node / JS
# ============================================================
node_modules/
.next/
.nuxt/
.cache/

# ============================================================
# OS cruft
# ============================================================
Thumbs.db
.DS_Store
desktop.ini
*.tmp
*.bak

# ============================================================
# IDE
# ============================================================
.vscode/
.idea/
.claude/

# ============================================================
# Runtime state (generated per-session, not source)
# ============================================================
STATE/
!STATE/.gitkeep

# ============================================================
# Sibling PERSONAL folders — voice APIs, portraits, ElevenLabs keys
# ============================================================
SIBLINGS/*/PERSONAL/
SIBLINGS/*/files/
# Clinical docs and MANIFEST are tracked — not secrets
!SIBLINGS/NEVAEH/files/
!SIBLINGS/NEVAEH/files/MANIFEST.md
!SIBLINGS/NEVAEH/files/LIGHTHOUSE/
!SIBLINGS/NEVAEH/files/LIGHTHOUSE/**
# EVERSOUND commercial deliverables are source artifacts, not secrets
!SIBLINGS/EVERSOUND/files/
!SIBLINGS/EVERSOUND/files/commercial/
!SIBLINGS/EVERSOUND/files/commercial/**

# ============================================================
# Telegram comms (contain keys or sensitive content)
# ============================================================
DOCTRINE/COMMUNICATION/001_telegram_to_nathan.md
DOCTRINE/COMMUNICATION/002_telegram_from_nathan.md

# ============================================================
# Room runtime logs / DB files
# ============================================================
SHARED/ROOM/room.db
SHARED/ROOM/room.db-shm
SHARED/ROOM/room.db-wal
